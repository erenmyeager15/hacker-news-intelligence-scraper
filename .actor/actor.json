{
  "actorSpecification": 1,
  "name": "hacker-news-intelligence-scraper",
  "title": "Hacker News Intelligence Scraper",
  "description": "Collect Hacker News feeds, keyword search results, exact items, and optional comment threads through the official Firebase API and public HN Algolia API.",
  "version": "1.0",
  "buildTag": "latest",
  "categories": ["DEVELOPER_TOOLS", "NEWS", "AUTOMATION"],
  "categoriesVersion": "1.0.0",
  "dockerfile": "Dockerfile",
  "input": "../INPUT_SCHEMA.json",
  "readme": "../README.md",
  "output": "./output_schema.json",
  "exampleRunInput": {
    "body": "{\"mode\":\"feed\",\"feed\":\"top\",\"query\":\"artificial intelligence\",\"searchType\":\"story\",\"itemIds\":[],\"maxResults\":1,\"minScore\":0,\"minComments\":0,\"includeKeywords\":[],\"excludeKeywords\":[],\"authors\":[],\"domain\":\"\",\"fromDate\":\"\",\"toDate\":\"\",\"includeComments\":false,\"maxCommentsPerItem\":20,\"commentDepth\":3,\"includeDeadOrDeleted\":false}",
    "contentType": "application/json; charset=utf-8"
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "fields": {},
      "views": {
        "overview": {
          "title": "Hacker News items",
          "transformation": {
            "fields": ["id", "type", "title", "url", "domain", "author", "score", "commentCount", "createdAt", "feed", "query", "hnUrl"]
          },
          "display": {
            "component": "table",
            "properties": {
              "id": { "label": "ID", "format": "number" },
              "type": { "label": "Type", "format": "text" },
              "title": { "label": "Title", "format": "text" },
              "url": { "label": "URL", "format": "link" },
              "domain": { "label": "Domain", "format": "text" },
              "author": { "label": "Author", "format": "text" },
              "score": { "label": "Score", "format": "number" },
              "commentCount": { "label": "Comments", "format": "number" },
              "createdAt": { "label": "Published", "format": "date" },
              "feed": { "label": "Feed", "format": "text" },
              "query": { "label": "Query", "format": "text" },
              "hnUrl": { "label": "HN discussion", "format": "link" }
            }
          }
        }
      }
    }
  },
  "defaultRunOptions": {
    "build": "latest",
    "memoryMbytes": 256,
    "timeoutSecs": 3600
  },
  "minMemoryMbytes": 256,
  "maxMemoryMbytes": 2048,
  "pricingInfo": {
    "pricingModel": "PAY_PER_EVENT",
    "pricingPerEvent": {
      "actorChargeEvents": {
        "apify-actor-start": {
          "eventTitle": "Actor Start",
          "eventDescription": "Charged when the Actor starts running. Number of events charged depends on Actor memory (one event per GB, minimum one event).",
          "isOneTimeEvent": true,
          "eventPriceUsd": 0.00005
        },
        "item-scraped": {
          "eventTitle": "Hacker News item scraped",
          "eventDescription": "One normalized Hacker News item written to the default dataset.",
          "isOneTimeEvent": false,
          "isPrimaryEvent": true,
          "eventPriceUsd": 0.00075
        }
      }
    }
  }
}
